{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelve",
  "version": "0.2.0",
  "identifier": "com.ahmed.shelve",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shelve — Your Personal Library",
        "width": 1100,
        "height": 600,
        "backgroundColor": "#0B0C0E",
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
